!output/.gitkeep
!output/AVTC/
!output/RAKEN/
output/AVTC/*
output/RAKEN/*
!output/AVTC/.gitkeep
!output/RAKEN/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

